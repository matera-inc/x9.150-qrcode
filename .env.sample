# =============================================================================
# X9 QRCode — Docker Compose environment overrides (sample)
# =============================================================================
# Docker Compose automatically loads a file named ".env" from this directory and
# substitutes ${VAR} placeholders in docker-compose*.yml. Copy this file to .env
# and adjust. Every value is optional — each has a built-in default in the compose file.
#
#   cp .env.sample .env
#   docker compose -f docker-compose.prod.yml up -d
#
# Or override per-launch without a file:
#   X9_PUBLICENDPOINTS_HOST=x9.mydomain.dev docker compose -f docker-compose.prod.yml up -d
#
# (.env is git-ignored — it may hold environment-specific values. .env.sample is tracked.)
# =============================================================================

# --- Public origin baked into QR codes and JWS headers (payload/loc, notification, JWKS, cert) ---
# No scheme. Must be <= 37 chars so the loc URL fits the EMV tag-26 budget (see ENDPOINTS.md).
X9_PUBLICENDPOINTS_HOST=x9-150.example.com
X9_PUBLICENDPOINTS_BASEPATH=/pub

# This service exposes an open, unauthenticated API. Access control is intentionally out of scope —
# protect it at your edge (API gateway, mTLS, or network policy).
