             \"explanation\": \"$1 discount because you're paying 10 days before\"\n                        }\n                    ],\n                    \"lateFees\": {\n                        \"fixed\": 15,\n                        \"perDay\": 25,\n                        \"explanation\": \"$15 administrative fee plus $25 per day interest\"\n                    }\n                }\n            }\n        }\n    },\n    \"unstructured\": \"Account: 987650001, Meter: MTR45567\",\n    \"additionalInformation\": [\n        {\n            \"key\": \"CustomerServiceRef\",\n            \"value\": \"CSREF-77283\"\n        }\n    ],\n    \"paymentNotification\": {\n        \"kind\": \"EXTERNAL\",\n        \"endpoint\": \"https://billing.california-eletric.com/payment-notifications\"\n    },\n    \"paymentMethods\": [\n        {\n            \"currency\": \"USD\",\n            \"validUntil\": \"2025-12-31T23:59:59Z\",\n            \"amount\": 100,\n            \"networks\": {\n                \"FedNow\": {\n                    \"routingNumber\": \"021000021\",\n                    \"accountNumber\": \"1234567890\",\n                    \"ultimateCreditor\": {\n                        \"routingNumber\": \"111222333\",\n                        \"accountNumber\": \"444555666\"\n                    }\n                }\n            }\n        }\n    ]\n}",
