          "script": {
            "exec": [
              "const requestBody = pm.request.body.toJSON();\r",
              "if (requestBody && requestBody.creditor && requestBody.creditor.MCC) {\r",
              "    pm.environment.set(\"expectedMCC\", requestBody.creditor.MCC.toString());\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
