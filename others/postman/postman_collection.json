    {
      "name": "Payment-Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Fixed variable declaration error\r",
              "const requestBody = pm.request.body && pm.request.body.raw ? JSON.parse(pm.request.body.raw) : {};\r",
              "const responseBody = pm.response.json(); // Corrected to define responseBody from response\r",
              "const responseData = responseBody; // Removed duplicate declaration\r",
              "\r",
              "// Validate MCC \r",
              "pm.test(\"Response message contains MCC (Tag 52) matching request\", () => {\r",
              "    const expectedMCC = requestBody.creditor && requestBody.creditor.MCC ? requestBody.creditor.MCC.toString() : \"\"; // Added optional chaining and default value\r",
              "    const mccRegex = /5204(\\d{4})/;\r",
              "    const mccMatch = responseBody.qrCode.match(mccRegex);\r",
              "\r",
              "    if (mccMatch) {\r",
              "        pm.expect(mccMatch[1]).to.equal(expectedMCC);\r",
              "    } else {\r",
              "        pm.expect.fail(\"MCC (Tag 52) with length 04 not found in the response message.\");\r",
              "    }\r",
              "});\r",
              "\r",
              "pm.test(\"Response message contains Transaction Amount (Tag 54)\", () => {\r",
              "    const amountRegex = /54\\d{2}[\\d.]+/; // Tag 54, length (2 digits), followed by one or more digits or dots\r",
              "    pm.expect(responseBody.qrCode).to.match(amountRegex);\r",
              "});\r",
              "\r",
              "// Validate status code\r",
              "pm.test(\"Status code is 201\", () => {\r",
              "    pm.response.to.have.status(201);\r",
              "    pm.collectionVariables.set(\"id\", responseBody.id);\r",
              "    pm.collectionVariables.set(\"emv\",pm.response.json().qrCode)\r",
              "    pm.collectionVariables.set(\"location\",pm.response.json().location.endpoint)\r",
              "});\r",
              "\r",
              "// Validate status code name\r",
              "pm.test(\"Status code name has string\", () => {\r",
              "    pm.response.to.have.status(\"Created\");\r",
              "});\r",
              "\r",
              "// Validate presence of 'id' field\r",
              "pm.test(\"Response has an 'id' field\", () => {\r",
              "    pm.expect(responseBody).to.have.property('id');\r",
              "});\r",
              "\r",
              "pm.test(\"'id' field is a valid QRCode identifier\", () => {\r",
              "    // Regex for a 32-character string containing only uppercase hexadecimal characters (A-F, 0-9)\r",
              "    const qrCodeRegex = /^[0-9A-F]{32}$/;\r",
              "\r",
              "    // Assuming the response body is JSON and the field is 'id'\r",
              "    const responseData = pm.response.json();\r",
              "    \r",
              "    // Check if the 'id' field matches the regex\r",
              "    pm.expect(responseData.id).to.match(qrCodeRegex);\r",
              "});\r",
              "\r",
              "// Validate presence of 'qrCode' field\r",
              "pm.test(\"Response has a 'qrCode' field\", () => {\r",
              "    pm.expect(responseBody).to.have.property('qrCode');\r",
              "});\r",
              "\r",
              "// Added definition for location variable\r",
              "const location = responseBody.location;\r",
              "\r",
              "pm.test(\"Response has a 'location' field\", () => {\r",
              "    pm.expect(location).to.have.property('id');\r",
              "    pm.expect(location).to.have.property('endpoint');\r",
              "});\r",
              "\r",
              "// Validate Payload Format Indicator (Tag 00)\r",
              "pm.test(\"Message contains Payload Format Indicator (Tag 00)\", () => {\r",
              "    pm.expect(responseBody.qrCode).to.match(/^000201/); // Tag 00, length 02, value \"01\"\r",
              "});\r",
              "\r",
              "// Validate Point of Initiation Method (Tag 01)\r",
              "pm.test(\"Message contains Point of Initiation Method (Tag 01)\", () => {\r",
              "    pm.expect(responseBody.qrCode).to.match(/01021[12]/); // Tag 01, length 02, value \"11\" (Static) or \"12\" (Dynamic)\r",
              "});\r",
              "\r",
              "// Validate presence of 'location' field\r",
              "pm.test(\"Response has a 'location' field\", () => {\r",
              "    pm.expect(location).to.exist; // Check if location exists\r",
              "});\r",
              "\r",
              "pm.test(\"Response IDs must be equal (id and location.id)\", function () {\r",
              "    // Check if fields exist before trying to compare them\r",
              "    pm.expect(responseData.id).to.exist;\r",
              "    pm.expect(responseData.location).to.exist;\r",
              "    pm.expect(responseData.location.id).to.exist;\r",
              "\r",
              "    // The main assertion: compares the IDs\r",
              "    pm.expect(responseData.id).to.eql(responseData.location.id);\r",
              "});\r",
              "\r",
              "// Fixed TypeError by using pm.test.skip\r",
              "pm.test(\"Request's locationId must be equal to the location's id in the Response\", function () {\r",
              "    // This condition ensures the test is only executed if the 'locationId' field exists in the REQUEST.\r",
              "    if (requestBody && requestBody.locationId) {\r",
              "        \r",
              "        // Log to help with debugging, showing the values being compared\r",
              "        console.log(`Request's locationId: ${requestBody.locationId}`);\r",
              "        console.log(`Response's Location id: ${responseData.location.id}`);\r",
              "        \r",
              "        // Check if the response's 'location.id' exists to avoid errors\r",
              "        pm.expect(responseData.location).to.exist;\r",
              "        pm.expect(responseData.location.id).to.exist;\r",
              "        \r",
              "        // The main assertion: compares the IDs\r",
              "        pm.expect(requestBody.locationId).to.eql(responseData.location.id);\r",
              "\r",
              "    } else {\r",
              "        // If the condition is not met, skip the test with an informative message\r",
              "        console.log(\"'locationId' field not found in the request body. Test not applicable.\");\r",
              "        pm.test.skip(); // Changed this.skip() to pm.test.skip()\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
