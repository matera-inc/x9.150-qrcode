    {
      "name": "Payment-Payload",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Build the signed request body the endpoint expects.",
              "// The payload is {\"qrCodeContent\": \"<base64 of the EMV string>\"}.",
              "const emv = pm.collectionVariables.get('emv') || pm.variables.get('emv');",
              "if (!emv) { throw new Error('Set the {{emv}} variable first - run Decode-EMV or Payment-Request.'); }",
              "",
              "pm.sendRequest({",
              "    url: pm.variables.replaceIn('{{x9qrcode_host}}/api/v1/signature/generate'),",
              "    method: 'POST',",
              "    header: {",
              "        'Content-Type': 'application/json',",
              "        'Correlation-Id': require('uuid').v4(),",
              "        'TTL-Seconds': '300'",
              "    },",
              "    body: { mode: 'raw', raw: JSON.stringify({",
              "        qrCodeContent: Buffer.from(emv, 'utf8').toString('base64')",
              "    }) }",
              "}, (err, res) => {",
              "    if (err) { throw err; }",
              "    pm.collectionVariables.set('payloadRequestJws', res.text());",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Removed duplicate tests and fixed adjustment structure",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Validates the JSON structure for the 'bill' object",
              "pm.test(\"Bill JSON structure validation\", function () {",
              "    const jsonData = pm.response.json();",
              "",
              "    // Ensures that the 'bill' object exists in the response",
              "    pm.expect(jsonData).to.have.property('bill');",
              "    const bill = jsonData.bill;",
              "",
              "    // Validations within the 'amountDue' object",
              "    pm.expect(bill).to.have.property('amountDue');",
              "    const amountDue = bill.amountDue;",
              "    pm.expect(amountDue).to.have.property('amount');",
              "    pm.expect(amountDue).to.have.property('currency');",
              "",
              "    // Validations within the 'adjustment' object",
              "    pm.expect(amountDue).to.have.property('adjustment');",
              "    const adjustment = amountDue.adjustment; // Fixed reference",
              "    pm.expect(adjustment).to.be.an('array'); // Ensure adjustment is an array",
              "    adjustment.forEach(adj => {",
              "        pm.expect(adj).to.have.property('explanation');",
              "        pm.expect(adj).to.have.property('amount');",
              "        pm.expect(adj).to.have.property('validUntil');",
              "    });",
              "});",
              "",
              "pm.test(\"Status code is 200 and response time is less than 200ms\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.responseTime).to.be.below(200);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
