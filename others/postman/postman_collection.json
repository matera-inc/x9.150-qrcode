              "    pm.expect(jsonData.paymentDetails).to.have.property('emv'); // Changed from 'endToEndId' to 'emv'",
              "",
              "    // 4. Extract the endToEndId value from the response",
              "    const responseEndToEndId = jsonData.paymentDetails.emv; // Changed from 'endToEndId' to 'emv'",
              "",
              "    // 5. Compare the response value with the global variable value",
              "    pm.expect(responseEndToEndId).to.eql(expectedEndToEndId, \"The EndToEndId from the response is equal to the global variable value\");",
