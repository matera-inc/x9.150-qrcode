# Copy to application-secrets.yml (git-ignored) and fill in real values.
# Passwords only — keystore/truststore LOCATIONS are set in application config
# (they point at secrets/certificate/). Place your .jks files there.
jasypt:
  encryptor:
    password: "change-me-jasypt-master-password"

x9:
  certificate:
    private-keystore:
      password: "change-me"          # or ENC(...) if jasypt-encrypted
      private-key-password: "change-me"
    truststore:
      password: "change-me"
